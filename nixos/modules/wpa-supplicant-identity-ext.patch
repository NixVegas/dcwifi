+static int wpa_config_parse_identity(const struct parse_data *data,
+				     struct wpa_ssid *ssid, int line,
+				     const char *value)
+{
+	char *tmp;
+	size_t res_len;
+
+	if (os_strcmp(value, "NULL") == 0) {
+		if (!ssid->eap.identity)
+			return 1; /* Already unset */
+		wpa_printf(MSG_DEBUG, "Unset configuration string 'identity'");
+		os_free(ssid->eap.identity);
+		ssid->eap.identity = NULL;
+		ssid->eap.identity_len = 0;
+		return 0;
+	}
+
+#ifdef CONFIG_EXT_PASSWORD
+	if (os_strncmp(value, "ext:", 4) == 0) {
+		char *name = os_strdup(value + 4);
+
+		if (!name)
+			return -1;
+		os_free(ssid->eap.identity);
+		ssid->eap.identity = (u8 *) name;
+		ssid->eap.identity_len = os_strlen(name);
+		ssid->eap.flags |= EAP_CONFIG_FLAGS_EXT_IDENTITY;
+		return 0;
+	}
+#endif /* CONFIG_EXT_PASSWORD */
+
+	tmp = wpa_config_parse_string(value, &res_len);
+	if (!tmp) {
+		wpa_printf(MSG_ERROR, "Line %d: failed to parse identity.",
+			   line);
+		return -1;
+	}
+	wpa_hexdump_ascii(MSG_MSGDUMP, data->name, (u8 *) tmp, res_len);
+
+	os_free(ssid->eap.identity);
+	ssid->eap.identity = (u8 *) tmp;
+	ssid->eap.identity_len = res_len;
+#ifdef CONFIG_EXT_PASSWORD
+	ssid->eap.flags &= ~EAP_CONFIG_FLAGS_EXT_IDENTITY;
+#endif /* CONFIG_EXT_PASSWORD */
+
+	return 0;
+}
+
+
+#ifndef NO_CONFIG_WRITE
+static char * wpa_config_write_identity(const struct parse_data *data,
+					struct wpa_ssid *ssid)
+{
+	if (!ssid->eap.identity)
+		return NULL;
+
+#ifdef CONFIG_EXT_PASSWORD
+	if (ssid->eap.flags & EAP_CONFIG_FLAGS_EXT_IDENTITY) {
+		char *buf = os_zalloc(4 + ssid->eap.identity_len + 1);
+
+		if (!buf)
+			return NULL;
+		os_memcpy(buf, "ext:", 4);
+		os_memcpy(buf + 4, ssid->eap.identity,
+			  ssid->eap.identity_len);
+		return buf;
+	}
+#endif /* CONFIG_EXT_PASSWORD */
+
+	return wpa_config_write_string(ssid->eap.identity,
+				       ssid->eap.identity_len);
+}
+#endif /* NO_CONFIG_WRITE */
